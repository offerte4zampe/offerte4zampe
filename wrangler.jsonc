{
  "name": "zampachiara",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/index.html",
      "/confronta-cibo.html",
      "/confronta-cibo",
      "/*.html",
      "/api/metrics",
      "/data/history/*",
      "/data/price-history*",
      "/data/price-observatory*",
      "/api/price-history*",
      "/api/price-alert*",
      "/api/alert*",
      "/api/watchlist*",
      "/osservatorio-prezzi",
      "/preferiti",
      "/leggere-storico-prezzi",
      "/prodotto",
      "/prodotto.html",
      "/prodotto/*",
      "/api/telegram/status",
      "/go/*",
      "/",
      "/marche",
      "/marca-*"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "offerte4zampe.it",
      "custom_domain": true
    }
  ],
  "main": "worker/index.mjs",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "keep_vars": true,
  "vars": {
    "SHIPPING_RULES_SOURCE": "json",
    "SHIPPING_SHADOW": "false",
    "PRICE_TRACKING_ENABLED": "false",
    "AMAZON_LINKS_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_PUBLISHER",
        "class_name": "TelegramPublisher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "telegram-v1",
      "new_sqlite_classes": [
        "TelegramPublisher"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "build": {
    "command": "python automation/fingerprint_assets.py --restore && python automation/check_d1_activation.py --prepare-build && node automation/normalize_catalog.cjs && python automation/build_product_catalog.py && python automation/build_home_data.py && python automation/build_catalog_preview.py && python automation/build_brand_pages.py && python automation/build_sitemaps.py && python automation/apply_product_metadata.py && python automation/apply_compact_comparator.py && python automation/apply_navigation.py && python automation/apply_freshness.py && python automation/apply_brand_links.py && python automation/clean_urls.py && python automation/apply_micro_fixes.py && python automation/apply_images.py && python automation/apply_semantics.py && python automation/remove_unverified_ads.py && python automation/build_catalog_index.py && O4Z_DISPOSABLE_BUILD=1 python automation/price_feature_gate.py && python automation/build_sitemaps.py && python automation/fingerprint_assets.py"
  },
  "analytics_engine_datasets": [
    {
      "binding": "OUTBOUND_CLICKS",
      "dataset": "offerte4zampe_outbound"
    }
  ]
}
