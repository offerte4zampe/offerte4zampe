{
  "name": "zampachiara-staging",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/index.html",
      "/confronta-cibo.html",
      "/confronta-cibo",
      "/*.html",
      "/api/metrics",
      "/prodotto",
      "/prodotto.html",
      "/prodotto/*",
      "/api/telegram/status",
      "/go/*",
      "/",
      "/marche",
      "/marca-*"
    ]
  },
  "build": {
    "command": "python automation/fingerprint_assets.py --restore && python automation/check_d1_activation.py --prepare-build && node automation/normalize_catalog.cjs && python automation/build_product_catalog.py && python automation/build_home_data.py && python automation/build_catalog_preview.py && python automation/build_brand_pages.py && python automation/build_sitemaps.py && python automation/apply_product_metadata.py && python automation/apply_compact_comparator.py && python automation/apply_navigation.py && python automation/apply_freshness.py && python automation/apply_brand_links.py && python automation/clean_urls.py && python automation/apply_micro_fixes.py && python automation/apply_images.py && python automation/apply_semantics.py && python automation/remove_unverified_ads.py && python automation/build_catalog_index.py && python automation/fingerprint_assets.py"
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [],
  "vars": {
    "SHIPPING_RULES_SOURCE": "json",
    "SHIPPING_SHADOW": "false"
  }
}
